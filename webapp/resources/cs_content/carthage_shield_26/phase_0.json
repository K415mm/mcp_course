  "questions": [
    {
      "id": "p0-q1",
      "type": "single_choice",
      "question": "What is the first operational posture?",
      "points": 20,
      "time_limit": 90,
      "options": [
        {"key": "A", "label": "Contain and segment", "color": "#ef4444", "points": 20},
        {"key": "B", "label": "Public communication first", "color": "#f59e0b", "points": 12},
        {"key": "C", "label": "Cross-sector war-room", "color": "#22c55e", "points": 18}
      ],
      "related_media": ["p0-map-overview"],
      "note": "Use as opening strategic vote."
    },
    {
      "id": "p0-q2",
      "type": "multi_choice",
      "question": "Select all immediate actions valid in the first 15 minutes.",
      "points": 15,
      "options": [
        {"key": "A", "label": "Confirm incident scope with SOC leads"},
        {"key": "B", "label": "Shut down all internet access nationwide"},
        {"key": "C", "label": "Activate single crisis communication channel"},
        {"key": "D", "label": "Freeze forensic evidence collection"}
      ],
      "acceptable_answers": ["A", "C"],
      "note": "Score manually from decision quality."
    },
    {
      "id": "p0-q3",
      "type": "order",
      "question": "Order these actions from first to fourth.",
      "points": 15,
      "options": [
        {"key": "A", "label": "Scope and validate telemetry"},
        {"key": "B", "label": "Open inter-agency coordination cell"},
        {"key": "C", "label": "Issue public holding statement"},
        {"key": "D", "label": "Launch containment actions"}
      ],
      "correct_order": ["A", "D", "B", "C"]
    },
    {
      "id": "p0-q4",
      "type": "short_answer",
      "question": "Write one sentence mission statement for this phase.",
      "prompt": "Max 25 words. Must include objective + time horizon + owner.",
      "points": 10
    }
  ]
}
